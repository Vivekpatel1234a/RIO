.pnp.js

# Next.js build output
.next/
out/
build/

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
env/

# Environment
.env
.env.local
.env.*.local

# Generated data / caches (regenerated by the backend).
# NOTE: `**/` is required because the backend lives at
# RIO-main/RIO-main/backend/ — a bare `backend/...` pattern never matched.
**/backend/storage/flood_cache/
**/backend/storage/projects/
**/backend/storage/exports/
**/backend/storage/*
**/backend/demo/
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local tooling state
.workbuddy-ai/
.dist/

# Large media: served by the local backend, not needed for the Vercel build.
# To publish them, use Git LFS: git lfs track "recordings/*.mp4"
recordings/
